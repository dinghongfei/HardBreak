{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "break_window_*",
    "config_window"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "notification:default",
    "sql:default",
    "sql:allow-execute"
  ]
}