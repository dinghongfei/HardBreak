{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HardBreak",
  "version": "0.6.0",
  "identifier": "HardBreak",
  "build": {
    "frontendDist": "../src",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
     {
        "label": "config_window",
        "url": "config.html",

        "title": "HardBreak",
        "hiddenTitle": true,
        "titleBarStyle": "Transparent",

        "width": 800,
        "height": 640,
        "resizable": false,
        "fullscreen": false,

        "transparent": false,
        "decorations": true,

        "visible": false,

        "devtools": false,
        "alwaysOnTop": false,


        "center": true,
        "contentProtected": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:config.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}



